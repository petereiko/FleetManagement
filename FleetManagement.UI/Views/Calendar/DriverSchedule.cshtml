@using FleetManagement.UI.Models.DriverDTOs.DriverViewModels
@model DriverScheduleViewModel

@{
    ViewData["Title"] = "Driver Schedule Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Include FullCalendar CSS and Global JS from CDN -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.js"></script>

<!-- Include jQuery (if not already included) and Font Awesome -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<link rel="stylesheet" href="https://npmcdn.com/flatpickr/dist/themes/material_green.css" ">


<style>
    /* Overall dashboard container */
    .schedule-dashboard {
    background-color: #f7f7f7;
    padding: 2rem;
    min-height: 80vh;
    }
    /* Left column (calendar and other drivers table) */
    .left-column {
    padding-right: 1rem;
    }
    .calendar-container {
    max-width: 100%;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    padding: 1rem;
    min-height: 350px;
    margin-bottom: 1.5rem;
    border: 1px solid #ddd;
    }
    /* Table for Other Drivers */
    .other-drivers-table {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    padding: 1rem;
    }
    .other-drivers-table table {
    margin-bottom: 0;
    }
    /* Right column (leave request and notice) */
    .right-column {
    padding-left: 1rem;
    }
    .leave-notice {
    background: #fff;
    border-left: 5px solid #ffc107;
    padding: 1rem;
    margin-bottom: 1.5rem;
    border-radius: 4px;
    }
    .leave-notice h6 {
    margin-bottom: 0.5rem;
    color: #dc3545;
    }
    .apply-leave-btn {
    margin-bottom: 1rem;
    }
    /* Leave Request Form (hidden initially) */
    .leave-request-form {
    display: none; /* Hidden by default */
    background: #fff;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    .leave-request-form h4 {
    text-align: center;
    margin-bottom: 1.25rem;
    }
    .timeoff-section {
    background: #fff;
    padding: 1rem;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    margin-top: 1.5rem;
    }
    .timeoff-section h5 {
    margin-bottom: 1rem;
    color: #007bff;
    }
</style>

<div class="container schedule-dashboard">
    <div class="row">
        <!-- Left Column: Calendar and Other Drivers -->
        <div class="col-md-8 left-column">
            <!-- Calendar Section -->
            <div class="calendar-container">
                <div id="calendar"></div>
            </div>

            <!-- Other Drivers Schedule Table -->
            <div class="other-drivers-table">
                <h5 class="mb-3">Other Drivers Schedule</h5>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Driver</th>
                            <th>Shift Start</th>
                            <th>Shift End</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var d in Model.OtherDrivers)
                        {
                            <tr>
                                <td>@d.DriverName</td>
                                <td>@d.ShiftStart.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@d.ShiftEnd.ToString("dd MMM yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right Column: Leave Request & Dashboard Info -->
        <div class="col-md-4 right-column">
            <!-- Leave Notice -->
            <div class="leave-notice">
                <h6>Leave Policy:</h6>
                <p>You are allowed <strong>@Model.AllowedLeaveDays</strong> days of leave per year.</p>
            </div>

            <!-- Button to Toggle Leave Request Form -->
            <div class="apply-leave-btn text-center mb-3">
                <button id="toggleLeaveRequest" class="btn btn-outline-primary">
                    <i class="fa fa-calendar-alt me-2"></i>Apply for Leave
                </button>
            </div>

            <!-- Leave Request Form (hidden initially) -->
            <div class="leave-request-form" id="leaveRequestForm">

                <h4 class="mb-3">Leave Request</h4>
                <form asp-action="SubmitLeaveRequest" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="StartDate" class="form-label">Leave Start Date</label>
                        <input type="text" id="StartDate" name="LeaveDate" class="form-control" readonly required />
                    </div>

                    <div class="mb-3">
                        <label for="EndDate" class="form-label">Leave End Date</label>
                        <input type="text" id="EndDate" class="form-control" readonly required />
                    </div>

                    <div class="mb-3">
                        <label for="LeaveDays" class="form-label">Number of Days</label>
                        <input type="number" id="LeaveDays" name="LeaveDays" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="LeaveType" class="form-label">Type of Leave</label>
                        <select id="LeaveType" name="LeaveType" class="form-select" required>
                            <option value="">--Select Leave Type--</option>
                            <option value="Annual">Annual Leave</option>
                            <option value="Sick">Sick Leave</option>
                            <option value="Casual">Casual Leave</option>
                            <option value="Maternity">Maternity/Paternity Leave</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="Reason" class="form-label">Reason (Optional)</label>
                        <textarea id="Reason" name="Reason" class="form-control" rows="3" placeholder="Provide reason for leave request"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-paper-plane me-2"></i>Submit Leave Request
                    </button>
                </form>

        </div>

        <br />
        <br />

            <div class="card earning-widget">
                <div class="card-body py-3 d-flex align-items-center collapse" style="">
                    <h4 class="card-title mb-0">Upcoming Time Off / Holidays</h4>

                    <div class="card-actions hstack gap-2.5 ms-auto">
                        <a href="javascript:void(0)" class="text-muted fs-5 d-flex" data-action="collapse" title="Collapse">
                            <i class="fa fa-minus"></i>
                        </a> 
                        <a href="javascript:void(0)" class="text-muted fs-5 d-flex" data-action="expand" title="Expand">
                            <i class="fa fa-expand"></i>
                        </a>
                    </div>
                </div>
                @if (Model.UpcomingTimeOff != null && Model.UpcomingTimeOff.Any())
                {
                    <div class="card-body border-top table-responsive no-wrap p-0 collapse show" style="">
                        <div class="message-box py-7 contact-box position-relative">
                            <div class="message-widget vstack gap-7 contact-widget position-relative">


                                @foreach (var t in Model.UpcomingTimeOff)
                                {

                                    <!-- contact -->
                                    <a href="javascript:void(0)" class="hstack px-7 gap-3">

                                        <div class="v-middle d-md-flex align-items-center w-100">
                                            <div class="text-truncate">
                                                <h5 class="mb-1">
                                                    @t.Title
                                                </h5>
                                                <span class="text-muted fs-3">
                                                    @t.StartDate.ToString("dd MMM")
                                                    -
                                                    @t.EndDate.ToString("dd MMM yyyy")
                                                </span>
                                            </div>
                                            <div class="ms-auto">
                                                <span class=" px-2 py-1 text-primary">@t.Status</span>
                                            </div>
                                        </div>
                                    </a>
                                }

                            </div>
                        </div>
                    </div>

                }


            </div>


        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>


<!-- Initialize FullCalendar -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');
        if (!calendarEl) {
            console.error("Calendar element not found!");
            return;
        }
        // Using same type for events
        var events = @Html.Raw(Json.Serialize(Model.Events ?? new List<FleetManagement.UI.Models.DriverDTOs.DriverViewModels.CalendarEvent>()));
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: events
        });
        calendar.render();




        const card = document.querySelector(".earning-widget");
        const collapseBtn = card.querySelector("[data-action='collapse']");
        const expandBtn = card.querySelector("[data-action='expand']");
        const collapsibleContent = card.querySelector(".collapse.show");

        collapseBtn.addEventListener("click", function () {
            collapsibleContent.classList.remove("show");
            collapseBtn.classList.add("d-none");
            expandBtn.classList.remove("d-none");
        });

        expandBtn.addEventListener("click", function () {
            collapsibleContent.classList.add("show");
            expandBtn.classList.add("d-none");
            collapseBtn.classList.remove("d-none");
        });

        // Optionally, initialize with collapse shown and expand hidden
        expandBtn.classList.add("d-none");
    });


    $(document).ready(function(){
        $("#toggleLeaveRequest").on("click", function(){
            $("#leaveRequestForm").slideToggle();
        });
    });



    document.addEventListener("DOMContentLoaded", function () {
        const startInput = document.getElementById("StartDate");
        const endInput = document.getElementById("EndDate");
        const daysInput = document.getElementById("LeaveDays");

        flatpickr(startInput, {
            dateFormat: "Y-m-d",
            onChange: function () {
                endPicker.set("minDate", startInput.value); // set min date for end
                calculateDays();
            }
        });

        const endPicker = flatpickr(endInput, {
            dateFormat: "Y-m-d",
            onChange: function () {
                calculateDays();
            }
        });

        function calculateDays() {
            const startDate = new Date(startInput.value);
            const endDate = new Date(endInput.value);

            if (!isNaN(startDate) && !isNaN(endDate) && endDate >= startDate) {
                const diffTime = endDate - startDate;
                const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;
                daysInput.value = diffDays;
            } else {
                daysInput.value = '';
            }
        }
    });

</script>