@model string




<form asp-action="AddMedical" method="post">
    <input type="hidden" name="driverId" value="@Model" />
    <div class="modal fade" id="addMedicalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title"><i class="fas fa-notes-medical me-2"></i>Add Medical Record</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-stethoscope me-1 text-secondary"></i> Medical Type</label>
                        <select name="Type" class="form-select" required>
                            <option disabled selected>-- Select Type --</option>
                            <option>Medical Exam</option>
                            <option>Eye Test</option>
                            <option>Drug Test</option>
                            <option>Physical</option>
                            <option>Hearing Test</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-calendar-alt me-1 text-secondary"></i> Next Due Date</label>
                        <input type="text" name="NextDueDate" class="form-control date-picker" id="nextDueDatePicker" placeholder="Select date" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-clinic-medical me-1 text-secondary"></i> Clinic</label>
                        <input type="text" name="Clinic" class="form-control" placeholder="e.g., Federal Clinic Abuja" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-sticky-note me-1 text-secondary"></i> Notes</label>
                        <textarea name="Notes" class="form-control" rows="3" placeholder="Optional additional notes..."></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit"><i class="fas fa-check-circle me-1"></i>Save Record</button>
                </div>
            </div>
        </div>
    </div>
</form>


