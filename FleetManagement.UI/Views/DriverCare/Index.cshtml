@using FleetManagement.UI.Models.DriverDTOs
@using FleetManagement.UI.Models.Dto
@using System.Text.Json

@model List<Driver>
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Driver Duty of Care";
    var careRecords = JsonSerializer.Deserialize<List<DriverCareRecord>>(HttpContextAccessor.HttpContext.Session.GetString("DriverCareRecords") ?? "[]");
}

<style>
    .driver-card {
        border-radius: 12px;
        border: 1px solid #e0e0e0;
        background: #fff;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
        transition: transform 0.2s ease-in-out;
    }

        .driver-card:hover {
            transform: translateY(-4px);
        }

    .driver-img {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #f0f0f0;
        margin-right: 1rem;
    }

    .driver-meta {
        flex-grow: 1;
    }

    .record-badge {
        font-size: 0.8rem;
        padding: 0.25rem 0.6rem;
        border-radius: 50rem;
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 6px;
    }

    .Available {
        color: #198754;
    }

    .OnDuty {
        color: #0d6efd;
    }

    .OffDuty {
        color: #dc3545;
    }
</style>

<h2 class="fw-bold mb-4">Driver Duty of Care</h2>
<p class="text-muted mb-4">Monitor each driver's medical and emergency contact readiness. Click a driver for full compliance record.</p>

<div class="row">
    @foreach (var driver in Model)
    {
        var fullName = $"{driver.FirstName} {driver.LastName}";
        var statusClass = driver.ShiftStatus.Replace(" ", "");
        var recordCount = careRecords.FirstOrDefault(c => c.DriverId == driver.Id)?.MedicalRecords?.Count ?? 0;

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="driver-card p-3 d-flex align-items-center">
                <img src="~/images/drivers/${@driver.Id}.jpg"
                     onerror="this.onerror=null;this.src='/images/drivers/default-placeholder.png';"
                     alt="Driver Photo"
                     class="driver-img" />

                <div class="driver-meta">
                    <h5 class="mb-0">@fullName</h5>
                    <small class="text-muted">@driver.LicenseCategory | <span class="@statusClass"><i class="status-dot @statusClass"></i> @driver.ShiftStatus</span></small>
                    <div class="mt-2">
                        <span class="badge bg-info record-badge">
                            <i class="fas fa-notes-medical me-1"></i>
                            @recordCount medical record@(recordCount == 1 ? "" : "s")
                        </span>
                    </div>
                </div>

                <div>
                    <a asp-action="Details" asp-route-id="@driver.Id" class="btn btn-sm btn-outline-primary ms-3">View</a>
                </div>
            </div>
        </div>
    }
</div>



















