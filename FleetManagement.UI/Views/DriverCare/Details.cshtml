@using FleetManagement.UI.Models.DriverDTOs
@using FleetManagement.UI.Models.Dto
@model Tuple<Driver, DriverCareRecord>
@{
    var driver = Model.Item1;
    var care = Model.Item2;
    ViewData["Title"] = $"{driver.FirstName} {driver.LastName} - Duty of Care";
}

<style>
    .card .badge.bg-primary {
        font-size: 0.7rem;
        padding: 4px 8px;
        border-radius: 8px;
        vertical-align: middle;
    }

</style>


<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-dark"><i class="fas fa-arrow-left"></i> Back to Driver List</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold">@driver.FirstName @driver.LastName</h3>
        <p class="text-muted mb-0">Duty of Care Record Overview</p>
    </div>
    <div>
        <button class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#addMedicalModal">
            <i class="fas fa-plus-circle me-1"></i> Add Medical Record
        </button>
        <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#addContactModal">
            <i class="fas fa-user-plus me-1"></i> Add Emergency Contact
        </button>
    </div>
</div>

<!-- Emergency Contacts -->
<h5 class="mb-3">📞 Emergency Contacts</h5>
<div class="row">
    @foreach (var contact in care.EmergencyContacts)
    {
        <div class="col-md-6 col-lg-4 mb-3">
            <div class="card shadow-sm border-0 position-relative h-100">
                <div class="card-body pb-2">
                    <h6 class="fw-semibold mb-1 text-dark">
                        <i class="fas fa-user-circle me-2 text-primary"></i>@contact.Name
                        @if (contact.IsPrimary)
                        {
                            <span class="badge bg-primary ms-2">Primary</span>
                        }
                    </h6>
                    <small class="text-muted"><i class="fas fa-user-tag me-1 text-secondary"></i> @contact.Relationship</small>
                    <div class="mt-2">
                        <i class="fas fa-phone-alt me-1 text-success"></i>
                        <span class="text-dark">@contact.PhoneNumber</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Medical Records -->
<h5 class="mt-5 mb-3">🩺 Medical Records</h5>
@if (!care.MedicalRecords.Any())
{
    <div class="alert alert-warning">No medical records found for this driver.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Date Issued</th>
                    <th>Next Due</th>
                    <th>Clinic</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var med in care.MedicalRecords)
                {
                    var expired = med.NextDueDate < DateTime.Today;
                    <tr>
                        <td><i class="fas fa-notes-medical text-secondary me-1"></i> @med.Type</td>
                        <td>@med.Date.ToString("yyyy-MM-dd")</td>
                        <td>@med.NextDueDate.ToString("yyyy-MM-dd")</td>
                        <td>@med.Clinic</td>
                        <td>
                            <span class="badge @(expired ? "bg-danger" : "bg-success")">
                                @(expired ? "Expired" : "Valid")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Partials -->
<partial name="_AddMedicalModal" model="driver.Id" />
<partial name="_AddContactModal" model="driver.Id" />
