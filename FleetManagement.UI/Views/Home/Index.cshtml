    <script>
        (function () {
          const steps = [1,2,3,4,5];
          let current = 1;
          const wizard = document.getElementById('quoteWizard');
          const nextBtn = document.getElementById('nextQuote');
          const cancelBtn = document.getElementById('cancelQuote');

          function showStep(n) {
            // tabs
            wizard.querySelectorAll('.nav-link').forEach(a=>{
              a.classList.toggle('active', +a.dataset.step === n);
            });
            // content
            wizard.querySelectorAll('.tab-pane').forEach(p=>{
              p.classList.toggle('show', +p.id.split('-')[1]===n);
              p.classList.toggle('active', +p.id.split('-')[1]===n);
            });
            nextBtn.textContent = n<5?'Next':'Submit';

            //Progress bar
                  // update progress UI:
        const percent = Math.round((n / 5) * 100);
        document.getElementById('currentStep').textContent = n;
        document.getElementById('currentPercent').textContent = percent + '%';
        const bar = document.getElementById('progressBar');
        bar.style.width = percent + '%';
        bar.setAttribute('aria-valuenow', percent);
          }

          nextBtn.addEventListener('click', ()=>{
            if (current < 5) {
              current++;
              showStep(current);
            } else {
              // gather data & POST /quote endpoint
              const payload = {
                vehicleType: wizard.querySelector('.type-btn.active')?.dataset.value,
                fleetSize: wizard.querySelector('.size-btn.active')?.dataset.value,
                features: Array.from(wizard.querySelectorAll('.feat:checked')).map(e=>e.value),
                email: document.getElementById('quoteEmail').value,
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                organization: document.getElementById('orgName').value,
                phone: document.getElementById('phone').value
              };
              console.log('Submitting quote:', payload);
              // TODO: AJAX POST /api/quote
              alert('Quote request submitted!');
              resetWizard();
            }
          });
          cancelBtn.addEventListener('click', resetWizard);

          // make option buttons toggle selection
          wizard.addEventListener('click', e=>{
            if (e.target.matches('.type-btn')) {
              wizard.querySelectorAll('.type-btn').forEach(b=>b.classList.remove('active'));
              e.target.classList.add('active');
            }
            if (e.target.matches('.size-btn')) {
              wizard.querySelectorAll('.size-btn').forEach(b=>b.classList.remove('active'));
              e.target.classList.add('active');
            }
          });

          function resetWizard(){
            current=1;
            // clear selections
            wizard.querySelectorAll('button.active').forEach(b=>b.classList.remove('active'));
            wizard.querySelectorAll('input').forEach(i=>i.type==='checkbox'?i.checked=false:i.value='');
            showStep(current);
          }

          // init
          showStep(current);
        })();
    </script>
