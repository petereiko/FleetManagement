                </div>
            </div>
        </div>

        <div class="p-3">
            <div class="form-group text-end">
                <button type="submit" class="btn btn-primary">
                    Submit
                </button>
                <button type="submit" class="btn bg-danger-subtle text-danger ms-6">
                    Cancel
                </button>
            </div>
        </div>
    </form>
</div>



<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

