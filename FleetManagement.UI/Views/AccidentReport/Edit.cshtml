@using FleetManagement.UI.Models.Dto
@model AccidentReportDto

@{
    ViewBag.Title = "File Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- SweetAlert2 CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="card">
    <div class="card-body pb-0">
        <h4 class="card-title">Edit accident details</h4>
    </div>
    <!-- Add an id to the form -->
    <form id="accidentForm" class="form-horizontal r-separator" asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.Partial("_AccidentReportForm", Model)

        <div class="p-3">
            <div class="form-group text-end">
                <button type="submit" class="btn btn-primary">
                    Update Report
                </button>
                <button type="button" class="btn bg-danger-subtle text-danger ms-6">
                    Cancel
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            flatpickr("#datePicker", {
                enableTime: false,
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "F j, Y",
                weekNumbers: true,
                theme: "material_blue",
            });
        });

        // Populate LGAs based on selected state
        const lgaMap = @Html.Raw(Json.Serialize(ViewBag.LGAs));
        document.getElementById("StateSelect").addEventListener("change", function() {
            const lgSelect = document.getElementById("LGASelect");
            lgSelect.innerHTML = "<option value=''>Choose LGA...</option>";
            (lgaMap[this.value] || []).forEach(lga => {
                let opt = document.createElement("option");
                opt.value = lga;
                opt.text = lga;
                lgSelect.appendChild(opt);
            });
        });

        // Intercept the form submission to display a confirmation dialog
        document.getElementById("accidentForm").addEventListener("submit", function (e) {
            e.preventDefault(); // Prevent immediate form submission
            Swal.fire({
                title: 'Confirm Submission',
                text: "Are you sure everything is correct? You won't be able to change it later.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, submit it!',
                cancelButtonText: 'No, let me check!'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Now submit the form
                    e.target.submit();
                }
            });
        });
    </script>
}

















