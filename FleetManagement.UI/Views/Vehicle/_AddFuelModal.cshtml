@model FleetManagement.UI.Models.Dto.FuelExpenseDto

<div class="modal fade" id="addFuelModal" tabindex="-1" aria-labelledby="addFuelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-controller="Vehicle" asp-action="Expense" method="post" enctype="multipart/form-data">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addFuelModalLabel">Add New Fuel Log</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FillingStation" class="form-label"></label>
                            <input asp-for="FillingStation" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FuelType" class="form-label"></label>
                            <select asp-for="FuelType" class="form-select">
                                <option>Petrol</option>
                                <option>Diesel</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Liters" class="form-label"></label>
                            <input asp-for="Liters" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PricePerLiter" class="form-label"></label>
                            <input asp-for="PricePerLiter" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Odometer" class="form-label"></label>
                            <input asp-for="Odometer" type="number" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label"></label>
                            <select asp-for="State" class="form-select">
                                <option>Lagos</option>
                                <option>Ogun</option>
                                <option>Abuja</option>
                                <option>Kano</option>
                                <option>Rivers</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LGA" class="form-label"></label>
                            <select asp-for="LGA" class="form-select">
                                <option>Eti-Osa</option>
                                <option>Garki</option>
                                <option>Oba</option>
                                <option>Nnewi</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Date" class="form-label"></label>
                            <input asp-for="Date" type="text" id="fuelDatePicker" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Receipt" class="form-label"></label>
                            <input asp-for="Receipt" type="file" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i> Save Log
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    flatpickr("#fuelDatePicker", {
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "F j, Y"
    });
</script>
