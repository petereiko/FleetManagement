@using FleetManagement.UI.Models.DriverDTOs
@using System.Text.Json

@model List<Driver>

@{
    ViewData["Title"] = "ViewAvailability";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var todayDate = DateTime.Now.Date.ToString("yyyy-MM-dd");
}

<h3 class="mb-4 fw-semibold">Check Driver's Availability & Activities</h3>

<style>
    .driver-item {
        padding: 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin-bottom: 10px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: background-color 0.2s ease;
    }

        .driver-item:hover, .driver-item.active {
            background-color: #f0f8ff;
        }

    .driver-details {
        padding: 2rem;
    }

    .status-badge {
        padding: 0.3rem 0.6rem;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .Available {
        background-color: #e6f9ec;
        color: #198754;
    }

    .OnDuty {
        background-color: #e0f0ff;
        color: #0d6efd;
    }

    .OffDuty {
        background-color: #fde2e2;
        color: #dc3545;
    }

    .distance-card {
        margin-top: 1rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
    }
</style>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="d-flex flex-wrap gap-3">
                <div>Total Drivers: <strong>@Model.Count()</strong></div>
                <div>Available: <span class="badge bg-success">@Model.Count(x => x.ShiftStatus == "Available")</span></div>
                <div>On Duty: <span class="badge bg-primary">@Model.Count(x => x.ShiftStatus == "On Duty")</span></div>
                <div>Off Duty: <span class="badge bg-danger">@Model.Count(x => x.ShiftStatus == "Off Duty")</span></div>
            </div>
        </div>
        <div class="col-md-6 d-flex justify-content-end gap-2">
            <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search driver..." style="max-width: 200px;" />
            <select id="statusFilter" class="form-select form-select-sm" style="max-width: 150px;">
                <option value="">All Status</option>
                <option value="Available">Available</option>
                <option value="On Duty">On Duty</option>
                <option value="Off Duty">Off Duty</option>
            </select>
            <select id="sortSelect" class="form-select form-select-sm" style="max-width: 180px;">
                <option value="recent">Recently Seen</option>
                <option value="oldest">Least Recent</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div id="driverListContainer" style="max-height: 70vh; overflow-y: auto;"></div>
        </div>

        <div class="col-md-8">
            <div class="driver-details border rounded shadow-sm bg-white" id="driverDetails">
                <h5 class="mb-3 fw-bold">Driver Details</h5>
                <div id="driverDetailContent" class="text-muted">Select a driver to view details.</div>

                <div id="distanceCard" class="distance-card d-none">
                    <h6>Distance Covered Today:</h6>
                    <h4 id="distanceValue" class="text-primary">0.00 km</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script>
    const drivers = @Html.Raw(JsonSerializer.Serialize(Model));
    const todayDate = '@todayDate';

    const driverListContainer = document.getElementById('driverListContainer');
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const sortSelect = document.getElementById('sortSelect');

    let selectedDriverId = null;
    let lastPosition = null;
    let totalDistanceKm = 0;
    let lastTrackedDate = todayDate;

    function renderDriverList(filteredDrivers) {
        driverListContainer.innerHTML = '';

        filteredDrivers.forEach(driver => {
            const dotClass = driver.ShiftStatus === "Available" ? "bg-success" :
                            driver.ShiftStatus === "On Duty" ? "bg-primary" : "bg-danger";

            const div = document.createElement('div');
            div.className = 'driver-item';
            div.id = `driver-${driver.Id}`;
            div.onclick = () => showDriverDetails(driver.Id);
            div.innerHTML = `
                <div>
                    <div><strong>${driver.FirstName} ${driver.LastName}</strong></div>
                    <span class="text-muted">${driver.LicenseCategory}</span>
                </div>
                <span class="status-badge ${driver.ShiftStatus.replace(/\s/g, '')}">
                    <span class="status-dot ${dotClass}"></span> ${driver.ShiftStatus}
                </span>
            `;
            driverListContainer.appendChild(div);
        });
    }

    function filterDrivers() {
        const search = searchInput.value.toLowerCase();
        const status = statusFilter.value;
        const sort = sortSelect.value;

        let filtered = drivers.filter(d => {
            const name = `${d.FirstName} ${d.LastName}`.toLowerCase();
            return name.includes(search) && (!status || d.ShiftStatus === status);
        });

        filtered.sort((a, b) => {
            const aTime = new Date(a.LastSeen).getTime();
            const bTime = new Date(b.LastSeen).getTime();
            return sort === 'recent' ? bTime - aTime : aTime - bTime;
        });

        renderDriverList(filtered);
    }

    function showDriverDetails(driverId) {
        const selected = drivers.find(d => d.Id === driverId);
        if (!selected) return;

        document.querySelectorAll('.driver-item').forEach(el => el.classList.remove('active'));
        document.getElementById('driver-' + driverId)?.classList.add('active');

        selectedDriverId = driverId;

        const fullName = `${selected.FirstName} ${selected.MiddleName} ${selected.LastName}`;
        const lastSeen = new Date(selected.LastSeen).toLocaleString("en-GB", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", second: "2-digit" });

        document.getElementById("driverDetailContent").innerHTML = `
            <div class="row">
                <div class="col-md-9">
                    <div class="row mb-3">
                        <div class="col-md-6"><strong>Full Name:</strong><br/> ${fullName}</div>
                        <div class="col-md-6"><strong>Contact Number:</strong><br/> ${selected.PhoneNumber}</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6"><strong>License Number:</strong><br/> ${selected.LicenseNumber}</div>
                        <div class="col-md-6"><strong>License Category:</strong><br/> ${selected.LicenseCategory}</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6"><strong>Shift Status:</strong><br/>
                            <span class="status-badge ${selected.ShiftStatus.replace(/\s/g, '')}">${selected.ShiftStatus}</span>
                        </div>
                        <div class="col-md-6"><strong>Last Seen:</strong><br/>
                            <i class="fas fa-clock text-secondary me-1"></i> ${lastSeen}
                        </div>
                    </div>
                </div>
                <div class="col-md-3 d-flex flex-column align-items-end">
                    <img src="/images/drivers/${selected.Id}.jpg"
                         onerror="this.onerror=null;this.src='/images/drivers/default-placeholder.png';"
                         alt="Driver Photo"
                         class="img-fluid border"
                         style="width: 120px; height: 150px; object-fit: cover;">
                    <div class="small text-muted mt-2">Driver Passport</div>
                </div>
            </div>

            <hr class="my-4" />
            <div class="row">
                <div class="col-md-12 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 fw-semibold">Driver Activity</h6>
                        <p class="text-muted mb-0 small">Click below to view history of this driver's assignments, status & trips.</p>
                    </div>
                    <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary btn-sm"
                               href="/Admin/TrackDriver?driverId=${selected.Id}"
                               target="_blank">
                               <i class="fas fa-route me-1"></i> View Driver Activity
                           </a>
                        <div class="dropdown">
                            <button class="btn btn-light btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                Actions
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Assign Trip</a></li>
                                <li><a class="dropdown-item" href="#">Message Driver</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        `;

        document.getElementById('distanceCard').classList.remove('d-none');
    }

    function updateDistanceUI() {
        document.getElementById("distanceValue").innerText = `${totalDistanceKm.toFixed(2)} km`;
    }

    // Calculate distance between 2 points
    function calculateDistance(pos1, pos2) {
        const R = 6371;
        const dLat = deg2rad(pos2.lat - pos1.lat);
        const dLon = deg2rad(pos2.lng - pos1.lng);
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(deg2rad(pos1.lat)) * Math.cos(deg2rad(pos2.lat)) * Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    function deg2rad(deg) {
        return deg * (Math.PI/180);
    }

    // SignalR Live Update
    const connection = new signalR.HubConnectionBuilder().withUrl("/vehicleTrackerHub").build();

    connection.on("ReceivePositionUpdate", (vehicleId, latitude, longitude) => {
        if (!selectedDriverId || vehicleId !== selectedDriverId) return; // Only track selected driver

        const nowDate = new Date().toISOString().split('T')[0];

        if (lastTrackedDate !== nowDate) {
            totalDistanceKm = 0;
            lastTrackedDate = nowDate;
        }

        const newPosition = { lat: parseFloat(latitude), lng: parseFloat(longitude) };

        if (!lastPosition) {
            lastPosition = newPosition; // Initialize first time
            return;
        }

        const distance = calculateDistance(lastPosition, newPosition);
        if (distance > 0.005) {  // ignore extremely tiny moves (like GPS noise)
            totalDistanceKm += distance;
            updateDistanceUI();
        }

        lastPosition = newPosition;
    });

    connection.start().then(() => {
        console.log("SignalR connected on Availability page.");
    }).catch(console.error);

    connection.start().then(() => console.log("Connected for live driver tracking.")).catch(console.error);

    filterDrivers();
</script>














