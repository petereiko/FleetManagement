@using FleetManagement.UI.Models.CompanyAssetDto;
@model List<Vehicle>

@{
    ViewData["Title"] = "Vehicle Tracker";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 24px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 24px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #22c55e; /* Tailwind green-500 */
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    .map-wrapper {
        max-width: 100%;
        margin: 0 auto;
        padding: 1rem;
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #e0e0e0;
        position: relative;
    }

    #map {
        height: 600px;
        width: 100%;
        border-radius: 10px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        margin-bottom: 30px;
        transition: box-shadow 0.3s ease;
    }

        #map:hover {
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        }

    @@media (max-width: 768px) {
        #map {
            height: 400px;
        }
    }

    .trail-toggle-wrapper {
        position: relative; /* ✅ was absolute */
        top: 0;
        right: 0;
        margin-left: auto; /* ✅ push to right if using flexbox */
        background-color: white;
        padding: 8px 12px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        margin-bottom: 10px; /* spacing before map */
    }

    .reset-btn {
        margin-bottom: 10px;
    }
</style>

<!-- Container for the map -->

<div class="map-wrapper">
    <!-- Follow Vehicle toggle (unchanged) -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <!-- Follow Vehicle toggle -->
        <div>
            <label class="switch">
                <input type="checkbox" id="followVehicleCheckbox" checked>
                <span class="slider"></span>
            </label>
            <span style="margin-left: 8px;">Follow Vehicle</span>
        </div>

        <!-- Trail toggle -->
        <div class="trail-toggle-wrapper">
            <label class="switch mb-0">
                <input type="checkbox" id="showTrailsCheckbox" checked>
                <span class="slider"></span>
            </label>
            <span>Show Trails</span>
        </div>

        <!-- Reset button -->
        <button class="btn btn-secondary reset-btn" onclick="resetZoom()">Reset Zoom</button>
    </div>


    <label for="vehicleSelect"><strong>Select Vehicle:</strong></label>
    <br />
    <select id="vehicleSelect" class="form-select mb-3" onchange="focusOnVehicle(this.value)">
        <option value="">-- Choose Vehicle --</option>
        @foreach (var vehicle in Model)
        {
            var displayName = $"{vehicle.LicensePlate} - {vehicle.AssignedDriverName}";
            <option value="@vehicle.Id">@displayName</option>
        }
    </select>
    <br />
    <button onclick="resumeAutoFollow()" class="btn btn-warning">Resume Auto-Follow</button>
    <br />
    <div id="map"></div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>


<script async defer
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDgRzgqRQPMuBq-XOmtkrpP5Pk9d7nmtAc&callback=initMap">
</script>


<script>
    var map;
    var vehicleMarkers = {};
    var vehicleLastUpdated = {};
    var vehiclePathHistory = {};
    var vehiclePolylines = {};
    var vehicleTrailColors = {};
    var vehicleStatus = {};
    var trailStartMarkers = {};

    let selectedVehicleId = null;
    let isFollowEnabled = true;
    let isTrailEnabled = true;
    let manualFollow = false;

    function initMap() {
        var vehicles = @Html.Raw(Json.Serialize(Model ?? new List<Vehicle>()));
        console.log("Vehicles data:", vehicles);

        map = new google.maps.Map(document.getElementById("map"), {
            zoom: 10,
            center: { lat: 6.5244, lng: 3.3792 },
            mapTypeControl: false,
            streetViewControl: false,
            fullscreenControl: false
        });

        var bounds = new google.maps.LatLngBounds();

        vehicles.forEach(function (vehicle) {
            var lat = parseFloat(vehicle.latitude || vehicle.Latitude);
            var lng = parseFloat(vehicle.longitude || vehicle.Longitude);
            var vehicleId = vehicle.id || vehicle.Id;

            if (!isNaN(lat) && !isNaN(lng) && (lat !== 0 || lng !== 0)) {
                var position = { lat: lat, lng: lng };

                var marker = new google.maps.Marker({
                    position: position,
                    map: map,
                    title: `${vehicle.licensePlate || 'Plate'} - ${vehicle.assignedDriverName || 'Driver'}`,
                    icon: {
                        url: "/images/car_front_vehicle_icon.svg",
                        scaledSize: new google.maps.Size(32, 32)
                    }
                });

                var infoWindow = new google.maps.InfoWindow();
                marker.infoWindow = infoWindow;

                marker.infoTemplate = function (lastSeenTime) {
                    return `
                        <strong>${vehicle.make} ${vehicle.model}</strong><br/>
                        Plate: ${vehicle.licensePlate}<br/>
                        Driver: ${vehicle.assignedDriverName}<br/>
                        <small style="color: gray;">Last seen: ${lastSeenTime}</small>
                    `;
                };

                infoWindow.setContent(marker.infoTemplate(new Date().toLocaleTimeString()));

                marker.addListener("click", function () {
                    infoWindow.open(map, marker);
                });

                bounds.extend(position);
                vehicleMarkers[vehicleId] = marker;
                vehicleLastUpdated[vehicleId] = new Date();
                vehicleTrailColors[vehicleId] = '#' + Math.floor(Math.random()*16777215).toString(16);
            }
        });

        if (!bounds.isEmpty()) {
            map.fitBounds(bounds);
        }

        const trailCheckbox = document.getElementById("showTrailsCheckbox");
        if (trailCheckbox) {
            trailCheckbox.addEventListener("change", () => {
                isTrailEnabled = trailCheckbox.checked;
                Object.values(vehiclePolylines).forEach(poly => poly.setMap(isTrailEnabled ? map : null));
                Object.values(trailStartMarkers).forEach(circle => circle.setMap(isTrailEnabled ? map : null));
            });
        }

        setInterval(() => {
            const now = new Date();
            Object.entries(vehicleMarkers).forEach(([vehicleId, marker]) => {
                const lastSeen = vehicleLastUpdated[vehicleId];
                if (!lastSeen) return;

                const secondsSince = (now - lastSeen) / 1000;
                const status = vehicleStatus[vehicleId] || { isOffline: false };

                if (secondsSince > 30 && !status.isOffline) {
                    status.isOffline = true;
                    marker.setIcon({ url: "/images/car_offline.svg", scaledSize: new google.maps.Size(32, 32) });
                } else if (secondsSince <= 30 && status.isOffline) {
                    status.isOffline = false;
                    marker.setIcon({ url: "/images/car_front_vehicle_icon.svg", scaledSize: new google.maps.Size(32, 32) });
                }

                vehicleStatus[vehicleId] = status;
            });
        }, 10000);

        console.log("Map initialized.");
    }

    function animateMarker(marker, targetPosition, duration = 1000) {
        const start = marker.getPosition();
        const startTime = performance.now();

        function step(timestamp) {
            const progress = Math.min((timestamp - startTime) / duration, 1);
            const lat = start.lat() + (targetPosition.lat() - start.lat()) * progress;
            const lng = start.lng() + (targetPosition.lng() - start.lng()) * progress;
            marker.setPosition(new google.maps.LatLng(lat, lng));
            if (progress < 1) requestAnimationFrame(step);
        }

        requestAnimationFrame(step);
    }

    const connection = new signalR.HubConnectionBuilder().withUrl("/vehicleTrackerHub").build();

    connection.on("ReceivePositionUpdate", (vehicleId, latitude, longitude) => {
        const lat = parseFloat(latitude);
        const lng = parseFloat(longitude);
        if (isNaN(lat) || isNaN(lng)) return;

        const newPos = new google.maps.LatLng(lat, lng);
        const marker = vehicleMarkers[vehicleId];
        if (!marker) return;

        animateMarker(marker, newPos);
        vehicleLastUpdated[vehicleId] = new Date();

        if (marker.infoWindow) {
            marker.infoWindow.setContent(marker.infoTemplate(vehicleLastUpdated[vehicleId].toLocaleTimeString()));
        }

        // 👇 Only pan to the selected vehicle if follow is active and selected
        if (isFollowEnabled && !manualFollow && selectedVehicleId === vehicleId) {
            map.panTo(newPos);
        }

        // Trails
        if (!vehiclePathHistory[vehicleId]) vehiclePathHistory[vehicleId] = [];

        const now = new Date();
        vehiclePathHistory[vehicleId].push({ position: newPos, timestamp: now });

        // Keep only last 1 minute of trail
        vehiclePathHistory[vehicleId] = vehiclePathHistory[vehicleId].filter(p =>
            (now - new Date(p.timestamp)) < 60000
        );

        const trailPath = vehiclePathHistory[vehicleId].map(p => p.position);

        if (!vehiclePolylines[vehicleId]) {
            vehiclePolylines[vehicleId] = new google.maps.Polyline({
                map: isTrailEnabled ? map : null,
                path: trailPath,
                geodesic: true,
                strokeColor: vehicleTrailColors[vehicleId] || '#00bfff',
                strokeOpacity: 0.8,
                strokeWeight: 3
            });
        } else {
            vehiclePolylines[vehicleId].setPath(trailPath);
        }

        // ✅ Only create the trail start marker ONCE — at the first position
        if (!trailStartMarkers[vehicleId]) {
            const startCircle = new google.maps.Circle({
                strokeColor: "green",
                strokeOpacity: 0.8,
                strokeWeight: 2,
                fillColor: "lightgreen",
                fillOpacity: 0.6,
                map: isTrailEnabled ? map : null,
                center: newPos, // fixed at first seen position
                radius: 15
            });
            trailStartMarkers[vehicleId] = startCircle;
        }
    });

    connection.start().then(() => console.log("SignalR connected.")).catch(console.error);

    function focusOnVehicle(vehicleId) {
        selectedVehicleId = vehicleId;
        manualFollow = true;

        const marker = vehicleMarkers[vehicleId];
        if (marker) {
            const pos = marker.getPosition();
            map.setCenter(pos);
            map.setZoom(16);
            google.maps.event.trigger(marker, "click");
        } else {
            alert("Vehicle location not available.");
        }
    }

    // Resume auto-follow
    function resumeAutoFollow() {
        manualFollow = false;
        console.log("Manual follow disabled, auto-follow will resume.");
    }

    document.addEventListener("DOMContentLoaded", () => {
        const followCheckbox = document.getElementById("followVehicleCheckbox");
        if (followCheckbox) {
            followCheckbox.addEventListener("change", () => {
                isFollowEnabled = followCheckbox.checked;
                console.log("Follow mode:", isFollowEnabled);
            });
        }
    });

    function resetZoom() {
        if (map) {
            map.setCenter({ lat: 6.5244, lng: 3.3792 });
            map.setZoom(10);
        }
    }
</script>



