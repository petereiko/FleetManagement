
@using FleetManagement.UI.Models.Dto
@model MaintenanceTicket

@{
    // Get all tickets from ViewBag (set in the controller)
    var tickets = ViewBag.AllTickets as List<MaintenanceTicket>;
    // For active highlighting in sidebar, use current ticket's number.
    var currentTicketNumber = Model.TicketNumber;
}

<!-- Main Container -->
<div class="container-fluid">
  <!-- Breadcrumb / Header -->
  <div class="font-weight-medium shadow-none position-relative overflow-hidden mb-7">
    <div class="card-body px-0">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h4 class="font-weight-medium fs-14 mb-0">Invoice</h4>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <a class="text-muted text-decoration-none" href="#">Home</a>
              </li>
              <li class="breadcrumb-item text-muted" aria-current="page">Invoice</li>
            </ol>
          </nav>
        </div>
        <div><!-- Additional header actions if needed --></div>
      </div>
    </div>
  </div>

  <!-- Main Invoice Application Card -->
  <div class="card overflow-hidden invoice-application">
    <div class="d-flex">
      <!-- Sidebar: Ticket List -->
      <div class="w-25 d-none d-lg-block border-end user-chat-box invoice-list-container" style="max-height:80vh; overflow-y:auto;">
        <div class="p-3 border-bottom">
          <form class="position-relative">
            <input type="search" class="form-control search-invoice ps-5" placeholder="Search Invoice">
            <i class="ti ti-search position-absolute top-50 start-0 translate-middle-y fs-6 text-dark ms-3"></i>
          </form>
        </div>
        <div class="app-invoice">
          <ul class="list-unstyled">
            @foreach (var ticket in tickets)
            {
              var isActive = ticket.TicketNumber == currentTicketNumber ? "bg-light-subtle" : "";
              <li>
                <a href="@Url.Action("Invoice", "Maintenance", new { ticketNumber = ticket.TicketNumber })"
                   class="d-block text-decoration-none p-3 border-bottom invoice-user listing-user @isActive"
                   data-ticket-number="@ticket.TicketNumber">
                  <div class="d-flex align-items-center">
                    <div class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center me-2">
                      <i class="fa fa-user fs-6"></i>
                    </div>
                    <div>
                      <h6 class="mb-0 invoice-customer">@ticket.DriverName</h6>
                      <small class="invoice-id">Id: #@ticket.TicketNumber</small><br />
                      <small class="invoice-date">@ticket.DateLogged.ToString("dd MMM yyyy")</small>
                    </div>
                  </div>
                </a>
              </li>
            }
          </ul>
        </div>
      </div>

      <!-- Invoice Details Section -->
            <div class="w-75 w-xs-100 chat-container">
                <div class="invoice-inner-part h-100" id="invoiceing-box">
                    @* Initially render the current invoice detail *@
                    @Html.Partial("_InvoicePartial", Model)
                </div>
            </div>
     
        </div>
      </div>
    </div>
  </div>

<!-- Include Bootstrap JS if not already in your layout -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Include jQuery if not already loaded (for AJAX) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $(".invoice-user").on("click", function (e) {
            e.preventDefault();
            var url = $(this).attr("href");

            // Load the selected ticket's invoice details via AJAX into the invoiceing-box
            $.ajax({
                url: url,
                type: "GET",
                headers: { "X-Requested-With": "XMLHttpRequest" },
                success: function (data) {
                    $("#invoiceing-box").html(data);
                },
                error: function () {
                    alert("Failed to load invoice details.");
                }
            });
        });
    });
</script>

















